<section class="cart">
  <div class="container">
    {% if cart.item_count == 0 %}
      <p>Your cart is empty.</p>
      <a class="btn" href="{{ routes.all_products_collection_url }}">Continue shopping</a>
    {% else %}
      <form action="{{ routes.cart_url }}" method="post" novalidate>
        <table class="cart-table">
          <thead>
            <tr>
              <th>Product</th>
              <th>Price</th>
              <th>Quantity</th>
              <th>Total</th>
            </tr>
          </thead>
          <tbody>
            {% for item in cart.items %}
              <tr class="cart-line">
                <td class="cart-line__product">
                  <a class="cart-line__image" href="{{ item.url }}">
                    {% if item.image %}
                      <img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.product.title | escape }}" loading="lazy">
                    {% endif %}
                  </a>
                  <div class="cart-line__details">
                    <a class="cart-line__title" href="{{ item.url }}">{{ item.product.title }}</a>
                    {% unless item.product.has_only_default_variant %}
                      <small class="cart-line__variant">{{ item.variant.title }}</small>
                    {% endunless %}
                    <a class="cart-line__remove" href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity=0">Remove</a>
                  </div>
                </td>
                <td>{{ item.final_price | money }}</td>
                <td>
                  <input class="qty" type="number" name="updates[{{ item.key }}]" value="{{ item.quantity }}" min="0">
                </td>
                <td>{{ item.final_line_price | money }}</td>
              </tr>
            {% endfor %}
          </tbody>
        </table>

        <div class="cart-footer">
          <div class="cart-notes">
            <label for="CartSpecialInstructions">Order notes</label>
            <textarea id="CartSpecialInstructions" name="note" rows="3">{{ cart.note }}</textarea>
          </div>
          <div class="cart-summary">
            <p class="subtotal"><span>Subtotal</span> <strong>{{ cart.total_price | money }}</strong></p>
            <div class="cart-actions">
              <button class="btn btn-outline" name="update" type="submit">Update cart</button>
              <button class="btn btn-primary" name="checkout" type="submit">Checkout</button>
            </div>
          </div>
        </div>
      </form>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Main cart",
  "settings": [],
  "presets": [ { "name": "Cart" } ]
}
{% endschema %}