{% if product %}
  <div class="product">
    <div class="product-gallery">
      {% if product.featured_image %}
        <img src="{{ product.featured_image | img_url: '800x' }}" alt="{{ product.featured_image.alt | escape }}">
      {% endif %}
    </div>
    <div class="product-details">
      <h1>{{ product.title }}</h1>
      <div class="price">
        {% if product.compare_at_price_max > product.price %}
          <span class="price-current">{{ product.price | money }}</span>
          <s class="price-compare">{{ product.compare_at_price_max | money }}</s>
        {% else %}
          {{ product.price | money }}
        {% endif %}
      </div>
      {% if product.description != blank %}
        <div class="rte">{{ product.description }}</div>
      {% endif %}

      {% form 'product', product %}
        {% if product.has_only_default_variant == false %}
          <div class="variants">
            <label for="variant-select">Options</label>
            <select id="variant-select" name="id">
              {% for variant in product.variants %}
                {% if variant.available %}
                  <option value="{{ variant.id }}">{{ variant.title }} - {{ variant.price | money }}</option>
                {% else %}
                  <option disabled="disabled">{{ variant.title }} - Sold out</option>
                {% endif %}
              {% endfor %}
            </select>
          </div>
        {% else %}
          <input type="hidden" name="id" value="{{ product.variants.first.id }}">
        {% endif %}
        <div class="quantity">
          <label for="Quantity">Quantity</label>
          <input id="Quantity" type="number" name="quantity" value="1" min="1">
        </div>
        <button type="submit" class="btn btn-primary" name="add">Add to cart</button>
      {% endform %}
    </div>
  </div>
{% else %}
  <p>Product not found.</p>
{% endif %}